{
  "name": "brandmyass",
  "version": "1.0.0",
  "private": true,
  "description": "Premium out-of-home advertising. On my arse.",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build && node -e \"const fs=require('fs');fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true});if(fs.existsSync('public'))fs.cpSync('public','.next/standalone/public',{recursive:true})\"",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:create": "tsx scripts/create-database.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed",
    "auction:settle": "tsx scripts/settle.ts",
    "auction:refunds": "tsx scripts/refunds.ts"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.28.0",
    "@stripe/react-stripe-js": "^3.1.1",
    "@stripe/stripe-js": "^5.10.0",
    "next": "^14.2.0",
    "pg": "^8.22.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
