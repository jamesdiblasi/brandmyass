# ---------------------------------------------------------------------------
# Database — a NEW database on the existing Azure PostgreSQL Flexible Server.
# ---------------------------------------------------------------------------
# The application connection. Note the database name is `brandmyass`, not
# `optello` — this app shares the server with the LeadNet dashboard but must not
# share its database.
DATABASE_URL=postgresql://leadnet_app:PASSWORD@optello-pg.postgres.database.azure.com:5432/brandmyass?sslmode=require

# Admin connection, pointed at the `postgres` database. Used ONLY by
# `npm run db:create`, which is a one-off. Do not ship this to the app.
DATABASE_ADMIN_URL=postgresql://optelloadmin:PASSWORD@optello-pg.postgres.database.azure.com:5432/postgres?sslmode=require

# Optional. If set, db:create grants this role CONNECT plus schema privileges on
# the new database, so the app can use a non-admin login.
BMA_DB_ROLE=leadnet_app
BMA_DB_NAME=brandmyass

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Start with TEST keys (sk_test_ / pk_test_). Card 4242 4242 4242 4242 will
# authorise a hold you can then watch get released by outbidding yourself.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# From `stripe listen --forward-to localhost:3002/api/stripe/webhook`, or from
# the Dashboard endpoint once deployed. Without this the webhook rejects
# everything and no bid can ever become the standing bid.
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:3002

# ---------------------------------------------------------------------------
# Campaign shape (read by `npm run db:seed`, first run only)
# ---------------------------------------------------------------------------
BMA_CAMPAIGN_DAYS=21
BMA_GOAL_CENTS=250000
